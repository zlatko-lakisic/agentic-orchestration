# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Agentic tool: local runtime data and secrets (never commit)
__output__/
_web_uploads/
__orchestrator_*/
harness_runs/

# Secrets (SSH creds, local keys — never commit)
.secrets/

# Local dev tools (not committed)
agentic-orchestration-tool/.tools/

# Example-local detached web (examples/verticals/*/start-web-bg.*)
examples/**/.web-server.pid
examples/**/.web-server.log

# Local publish helpers (do not commit)
publish-github.sh
publish-github.ps1

.DS_Store

# Dependencies (never commit installed packages)
node_modules/

# Site / Pages build
site/dist/
_site/
docs/.jekyll-cache/
docs/.sass-cache/
docs/vendor/config/env.host

# Host-written live metrics (Jetson jtop/tegrastats, etc.)
/var/

# Custom tool sandbox runtime (local dev)
agentic-orchestration-tool/_tool_artifacts/
agentic-orchestration-tool/_tool_sandbox/
