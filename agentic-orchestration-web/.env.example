# Copy to .env and adjust. Loaded automatically on npm start.

# Listen on all interfaces (LAN / Docker). Default in code is 127.0.0.1 only.
AGENTIC_WEB_HOST=0.0.0.0

# AGENTIC_WEB_PORT=3847
# AGENTIC_TOOL_ROOT=../agentic-orchestration-tool
# AGENTIC_PYTHON=

# When stopping the background web server: ./stop-web-bg.sh with this set to 1 runs fuser -k on AGENTIC_WEB_PORT (Linux).
# AGENTIC_WEB_KILL_PORT=1

# After each OpenAI-proxy or WebSocket run, delete `<tool>/_web_uploads/<uuid>/` (uploads + extracted video frames).
# Default: deleted unless you set persistence on:
# AGENTIC_WEB_PERSIST_UPLOADS=1

# Optional: pass through vertical overlay env vars to Python (same names as agentic-orchestration-tool/.env).
# See ../examples/verticals/healthcare/web.env.append
# LLM Vision / OpenAI-proxy: reset orchestrator session each POST so unrelated jobs do not share
# planner_history + last_crew_output_excerpt (default on). Set to 0 only if you use agentic.sessionId for continuity.
# AGENTIC_OPENAI_PROXY_ORCHESTRATOR_SESSION_RESET=1

# OpenAI-compatible POST /v1/chat/completions|responses: attachment size caps (bytes).
# Defaults: image (and other non-video MIME) 5 MiB each; video 80 MiB each; total manifest 200 MiB.
# AGENTIC_OPENAI_PROXY_MAX_IMAGE_BYTES=5242880
# AGENTIC_OPENAI_PROXY_MAX_VIDEO_BYTES=83886080
# AGENTIC_OPENAI_PROXY_MAX_ATTACHMENT_TOTAL_BYTES=209715200
# Fetch http(s) URLs from message image_url / video_url (off = data URLs and agentic.files only).
# AGENTIC_OPENAI_PROXY_FETCH_MEDIA_URLS=1
# If FETCH_MEDIA_URLS is unset, AGENTIC_OPENAI_PROXY_FETCH_IMAGE_URLS controls both image and video URLs.

# Edge / Jetson web UI defaults (set AGENTIC_WEB_DEFAULT_RUN_MODE to enable hello uiDefaults).
# See agentic-orchestration-tool/config/env.jetson and scripts/jetson-apply-env.sh
# AGENTIC_WEB_DEFAULT_RUN_MODE=dynamic
# AGENTIC_WEB_DEFAULT_AUTO_ITER=0
# AGENTIC_WEB_DEFAULT_ITERATIVE_ROUNDS=2
# AGENTIC_WEB_DEFAULT_ITERATIVE_MAX_ROUNDS=3
# Performance UI defaults (seed checkboxes when AGENTIC_WEB_DEFAULT_RUN_MODE is set):
# AGENTIC_WEB_DEFAULT_RESET_SESSION_SIMPLE=1
# AGENTIC_WEB_DEFAULT_LIMIT_PLANNER_HISTORY=1
# AGENTIC_WEB_DEFAULT_SKIP_FINAL_QA=1
# AGENTIC_WEB_DEFAULT_SKIP_LEARNING_EVAL=1
# Per-run planner trim when “Limit planner session context” is checked:
# AGENTIC_WEB_PLANNER_MAX_TURNS=2
# AGENTIC_WEB_PLANNER_EXCERPT_CHARS=4000
# Ollama planner warm-up (loads AGENTIC_PLANNER_MODEL on server start; default on for ollama/* planners):
# AGENTIC_OLLAMA_KEEPALIVE=1
# AGENTIC_OLLAMA_KEEP_ALIVE=-1
# AGENTIC_OLLAMA_KEEPALIVE_INTERVAL_MS=300000
# Planner LLM greeting on WebSocket connect (default on). Set 0 to use static welcome only.
# AGENTIC_WEB_PLANNER_GREET=1
# Proxy-injected display name for personalization (HTTP + WebSocket upgrade headers):
# AGENTIC_WEB_USER_NAME_HEADER=X-Agentic-User-Name,X-User-Name
# Proxy-injected orchestrator session id (HTTP + WebSocket upgrade headers):
# AGENTIC_WEB_SESSION_ID_HEADER=X-Agentic-Session-Id,X-Warpgate-Session-Id
# Host metrics WebSocket push interval (ms; default 2000):
# AGENTIC_WEB_HOST_METRICS_PUSH_MS=2000
# Static fallback when planner greet fails or AGENTIC_WEB_PLANNER_GREET=0 (set 0 to disable):
# AGENTIC_WEB_WELCOME_MESSAGE=Hello! How can I help you today?

# Comma-separated catalog ids for POST /v1/chat/completions|responses dynamic planner (skips Ollama/HF unless listed).
# Example for Jetson without local Ollama: AGENTIC_OPENAI_PROXY_DYNAMIC_AGENT_PROVIDER_IDS=gpt_write
# AGENTIC_OPENAI_PROXY_DYNAMIC_AGENT_PROVIDER_IDS=

# POST /v1/chat/completions|responses backend (default auto):
#   auto         — gpt-*/o1* → OpenAI cloud; name:tag / ollama/* → OLLAMA_API_BASE; else orchestrate
#   orchestrate  — always spawn main.py (legacy)
#   openai       — always proxy to OPENAI_BASE_URL + OPENAI_API_KEY
#   ollama       — always proxy to OLLAMA_API_BASE OpenAI-compat /v1
# AGENTIC_CHAT_COMPLETIONS_BACKEND=auto
# Cap concurrent Ollama proxy calls (Home Assistant watering fires many sequential zone prompts):
# AGENTIC_CHAT_COMPLETIONS_OLLAMA_MAX_CONCURRENT=2
# If the requested Ollama tag is not pulled, retry with this model (defaults to planner ollama tag):
# AGENTIC_CHAT_COMPLETIONS_OLLAMA_FALLBACK_MODEL=llama3.2:3b
# Cloud key required on ADA for HA LLM Vision (gpt-4o-mini):
# OPENAI_API_KEY=

# AGENTIC_ORCHESTRATOR_CONTEXT_FILE=
# AGENTIC_EXTRA_AGENT_PROVIDERS_CATALOG_DIRS=
# AGENTIC_EXTRA_MCP_PROVIDERS_PATH=
# AGENTIC_MCP_HEALTHCARE_TOOLS_ENABLED=1
