# Repo layout: workflow YAML → config/workflows/*.yaml; --dynamic defs → config/agent_providers/*.yaml
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: use a slim catalog (e.g. cloud-only) instead of the full config/agent_providers tree.
# Jetson gateway calling OpenAI + Claude only:
# Jetson / edge: local Ollama only (see config/agent_providers_jetson/README.md)
# AGENTIC_AGENT_PROVIDERS_CATALOG=config/agent_providers_jetson
# AGENTIC_PLANNER_MODEL=ollama/llama3.2:3b
# AGENTIC_OPENAI_PROXY_DYNAMIC_AGENT_PROVIDER_IDS=ollama_llama3_2_3b
# AGENTIC_ASSUME_VRAM_GB=48
# AGENTIC_ASSUME_GPU=1
# Do not set OLLAMA_HOST / OLLAMA_API_BASE in .env when using k8s — jetson-sync-k8s-secret.sh injects
# host.k3s.internal for both (LiteLLM planner needs OLLAMA_API_BASE).
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AGENTIC_PLANNER_MODEL=openai/gpt-4o-mini
# Clear AGENTIC_EXTRA_AGENT_PROVIDERS_CATALOG_DIRS so overlays do not merge local Ollama/HF back in.

# Anthropic Claude (type: anthropic in config/agent_providers/*.yaml)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional custom API base (proxy / region endpoint). Also accepted: ANTHROPIC_API_URL.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Hugging Face Hub (type: huggingface — LiteLLM). Prefer HF_TOKEN.
# HF_TOKEN=hf_your_token_here
# Alternative name also supported by the tooling:
# HUGGINGFACE_API_KEY=hf_your_token_here
# Optional Inference Endpoint / custom API base:
# HUGGINGFACE_API_BASE=https://your-endpoint.huggingface.cloud

# Optional: OpenAI-compatible local server (LM Studio, vLLM, Ollama /v1, etc.).
# If unset, cloud OpenAI is used. `/v1` is appended when missing.
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Dynamic orchestration (--dynamic): planner model and limits.
# The planner runs via LiteLLM by default (same backbone CrewAI uses), so you can point it at:
# - OpenAI:      openai/gpt-4o-mini
# - Anthropic:   anthropic/claude-3-5-sonnet-20241022
# - HuggingFace: huggingface/meta-llama/Llama-3.3-70B-Instruct
# - Ollama:      ollama/llama3.2
# If you omit the "<provider>/" prefix, "openai/" is assumed.
# AGENTIC_PLANNER_MODEL=openai/gpt-4o-mini
# Jetson / local Ollama (must match `ollama list`; smaller = less VRAM/RAM):
# AGENTIC_PLANNER_MODEL=ollama/qwen2.5:7b-instruct
# AGENTIC_PLANNER_MODEL=ollama/qwen2.5:3b-instruct
# AGENTIC_PLANNER_MODEL=ollama/llama3.2:3b
# AGENTIC_PLANNER_MAX_STEPS=8
# Set to 0/false if your server does not support response_format json_object.
# AGENTIC_PLANNER_JSON_MODE=1
# AGENTIC_PLANNER_DEBUG=1   # stderr: raw planner LLM text + parsed JSON when validation fails (e.g. empty steps)
# AGENTIC_PLANNER_DEBUG_CHARS=6000
# AGENTIC_PLANNER_PROGRESS_LOG=1   # stderr: one line before each planner LLM call (default on). Set 0 to silence.
# AGENTIC_PLANNER_TIMEOUT_SEC=600  # optional LiteLLM / legacy HTTP timeout (seconds). Omit for LiteLLM default wait.
# Set to 0 to force the legacy direct OpenAI HTTP call (requires OPENAI_API_KEY).
# AGENTIC_PLANNER_USE_LITELLM=1
# If the planner returns invalid JSON (e.g., empty steps), retry once with a repair instruction.
# AGENTIC_PLANNER_REPAIR_RETRY=1
# OpenAI 429 handling:
# - Retry/backoff count for transient 429s
# AGENTIC_PLANNER_429_RETRIES=2
# - If 429 includes "Request too large ... TPM", the tool auto-shrinks the planner context and retries:
#   keep only the last N non-system messages and truncate long ones.
# AGENTIC_PLANNER_CONTEXT_TURNS=6
# AGENTIC_PLANNER_MESSAGE_CHARS=8000
# Jetson / local Ollama: if logs sit on "planner LLM" for minutes, stderr prompt~chars is huge — try
# AGENTIC_PLANNER_CONTEXT_TURNS=3 and AGENTIC_PLANNER_MESSAGE_CHARS=4000 (or reset a bloated orchestrator session).
#
# Crew execution: after LiteLLM/Hugging Face rejects a planned HF model at runtime (e.g.
# model_not_supported), rebuild the workflow once and retry. Fallback catalog id per HF agent:
# YAML exec_fallback_provider / execution_fallback_provider_id, else AGENTIC_EXEC_FALLBACK_PROVIDER_ID,
# else default ollama_llava. Matching HF tasks when the Hub model string appears in the error;
# AGENTIC_EXEC_FALLBACK_REPLACE_ANY_HF=1 swaps every HF task in that plan.
# AGENTIC_EXEC_FALLBACK_PROVIDER_ID=ollama_llama3_2_vision
# AGENTIC_EXEC_FALLBACK_REPLACE_ANY_HF=0
#
# Dual execution backend (in-process CrewAI is the default; zero regression for existing runs).
# AGENTIC_EXECUTION_BACKEND=inprocess   # inprocess | subprocess | kubernetes
# Subprocess backend: set to 1 to run each workflow step via `python main.py --execute-step` workers.
# When unset or 0, subprocess backend falls back to in-process CrewAI (safe default).
# AGENTIC_SUBPROCESS_WORKERS=0
#
# Shared run store for distributed step handoffs: {AGENTIC_RUN_STORE_PATH}/{run_id}/{step_id}/result.json
# Set to a mounted path (e.g. /run/store on a PVC) for subprocess workers or K8s Jobs sharing one volume.
# When unset, each run uses a temp directory (local dev default).
# AGENTIC_RUN_STORE_PATH=/run/store
#
# Kubernetes backend: MCP policy K0.6 / K4 — native HTTP MCPs by default; stdio via sidecar/gateway.
# AGENTIC_K8S_ALLOW_STDIO_MCPS=0
# Cluster HTTP gateways for stdio MCPs (runtime rewrite to streamable_http — see deploy/k8s/mcp-sidecars/):
# AGENTIC_K8S_MCP_FETCH_URL=http://agentic-mcp-fetch.agentic-orchestration.svc.cluster.local:8080/mcp
# AGENTIC_K8S_MCP_FILESYSTEM_URL=http://agentic-mcp-filesystem.agentic-orchestration.svc.cluster.local:8081/mcp
# In-pod supergateway sidecars (comma-separated MCP ids): filesystem_local (fetch_url uses worker stdio by default)
# AGENTIC_K8S_POD_SIDECAR_MCPS=filesystem_local
# Stdio MCPs that run inside the worker container (default fetch_url; filesystem_local needs Node in worker image)
# AGENTIC_K8S_WORKER_STDIO_MCPS=fetch_url,filesystem_local
# K8s filesystem sandbox on the run-store PVC (default subdir mcp-fs-workspace):
# AGENTIC_K8S_MCP_FILESYSTEM_DIR=/run/store/mcp-fs-workspace
# Set to 0 to disable worker-native stdio MCPs
# AGENTIC_K8S_SUPERGATEWAY_STATEFUL=0
# AGENTIC_K8S_SUPERGATEWAY_IMAGE=supercorp/supergateway:uvx
# Optional worker Job scheduling/resources (K4.5):
# AGENTIC_K8S_WORKER_RESOURCES={"requests":{"cpu":"500m","memory":"1Gi"}}
# AGENTIC_K8S_GPU_NODE_SELECTOR={"cloud.google.com/gke-accelerator":"nvidia-tesla-t4"}
# AGENTIC_K8S_GPU_PROVIDER_IDS=ollama_llava
# Worker container image for K8s Jobs (build: docker/Dockerfile.worker — see docker/README.worker.md).
# AGENTIC_K8S_WORKER_IMAGE=agentic-orchestrator-worker:local
# Coordinator image for in-cluster web + orchestrator (K3.7 — build from monorepo root):
#   docker build -f docker/Dockerfile.coordinator -t agentic-orchestrator-coordinator:local ..
# See deploy/k8s/coordinator/ and docker/README.coordinator.md
# AGENTIC_K8S_NAMESPACE=agentic-orchestration
# AGENTIC_K8S_RUN_STORE_PVC=agentic-run-store
# AGENTIC_K8S_RUN_STORE_MOUNT=/run/store
# Run-store volume backend for deploy/k8s manifests (scripts/k8s-apply-run-store.*):
#   hostpath  — kind local bind mount (recommended with scripts/k8s-kind-up.ps1 + D:\run)
#   nfs       — in-cluster NFS for kind/local
#   filestore — GKE Filestore CSI (ReadWriteMany)
# AGENTIC_K8S_RUN_STORE_VOLUME=hostpath
# Host path bind-mounted into kind nodes (hostpath volume only; defaults to AGENTIC_RUN_STORE_PATH):
# AGENTIC_K8S_RUN_STORE_HOST_PATH=D:/run
# GKE Filestore only (VPC network name + tier for StorageClass):
# AGENTIC_K8S_FILESTORE_NETWORK=default
# AGENTIC_K8S_FILESTORE_TIER=standard
# AGENTIC_K8S_JOB_TTL_SECONDS=3600
# AGENTIC_K8S_JOB_TIMEOUT_SECONDS=3600
# AGENTIC_K8S_ENV_SECRET=agentic-orchestrator-env
# K5 warm pool: dequeue steps from run-store PVC instead of one-shot Jobs (no sidecar steps)
# AGENTIC_K8S_WARM_POOL_ENABLED=0
# K5 delegation RPC: worker k8s_delegate_task tool + delegation-broker Deployment
# AGENTIC_K8S_DELEGATION_ENABLED=0
# AGENTIC_K8S_DELEGATION_TIMEOUT_SECONDS=3600
# K5 structured logs for Loki/Datadog (coordinator + warm pool); workers also honor this in emit_log
# AGENTIC_LOG_FORMAT=text
#
# Video attachments (--dynamic-attachments manifest): ffmpeg samples JPEG frames + optional LiteLLM synopsis.
# Requires `ffmpeg` and `ffprobe` on PATH (or set AGENTIC_VIDEO_FFMPEG / AGENTIC_VIDEO_FFPROBE).
# AGENTIC_VIDEO_EXTRACT_FRAMES=1
# AGENTIC_VIDEO_MAX_FRAMES=16
# AGENTIC_VIDEO_FRAME_MAX_WIDTH=896
# AGENTIC_VIDEO_FRAME_CACHE=1
# AGENTIC_VIDEO_VISION_SYNOPSIS=1
# Max frames passed to the vision model (subset of extracted frames).
# AGENTIC_VIDEO_VISION_MAX_FRAMES=8
# AGENTIC_VIDEO_VISION_MAX_TOKENS=1200
# Defaults to AGENTIC_PLANNER_MODEL when unset (use a vision-capable model, e.g. openai/gpt-4o-mini or ollama/llava).
# AGENTIC_VIDEO_VISION_MODEL=openai/gpt-4o-mini
#
# Dynamic planner: when user text lexically matches specialist provider hints much better than
# general-purpose entries (YAML `general_purpose: true` or AGENTIC_GENERAL_PURPOSE_AGENT_IDS),
# omit those general providers from the planner catalog so domain agents win by default.
# AGENTIC_DOMAIN_PROVIDER_MATCH_MIN=4
# AGENTIC_DISABLE_DOMAIN_PROVIDER_SUPPRESSION=1
# Optional extra comma-separated ids treated as general-purpose:
# AGENTIC_GENERAL_PURPOSE_AGENT_IDS=gpt_reason
# Planner may still output gpt_research/claude_research after suppression; remap → best lexical specialist (default).
# Disable that safety remap:
# AGENTIC_PLANNER_STRICT_PROVIDER_IDS=1
# Optionally remap ANY unknown planner id instead of failing (risky if ids are typo'd):
# AGENTIC_PLANNER_REMAP_ANY_UNKNOWN_ID=1
# AGENTIC_PLANNER_SINGLE_AGENT_LLM=1  # force planner LLM even when only one agent remains (default: trivial 1-step plan)
#
# Dynamic runs always persist planner + crew excerpt JSON under __orchestrator_sessions__/
# (gitignored). With no --orchestrator-session and no AGENTIC_ORCHESTRATOR_SESSION, the file is
# `<slug>.json` where slug defaults to "default" (override slug via AGENTIC_ORCHESTRATOR_DEFAULT_SESSION).
# AGENTIC_ORCHESTRATOR_DEFAULT_SESSION=my-project
# Same as CLI --orchestrator-session NAME when set:
# AGENTIC_ORCHESTRATOR_SESSION=my-project
# Cap stored planner user/assistant pairs (default 12). Crew output excerpt length default 15000.
# Each assistant turn includes the planner JSON plus a snapshot of resolved agent providers/tasks.
# AGENTIC_ORCHESTRATOR_MAX_PLANNER_TURNS=12
# AGENTIC_ORCHESTRATOR_EXCERPT_CHARS=15000
# AGENTIC_ORCHESTRATOR_TASK_DESC_CHARS=500
# AGENTIC_ORCHESTRATOR_TASK_OUTPUT_CHARS=320

# Vertical / industry overlays (optional)
# Append free-text domain rules to the dynamic planner, iterative controller, learning evaluator,
# and faithfulness QA system prompts (e.g. healthcare compliance tone, no patient-specific advice).
# AGENTIC_ORCHESTRATOR_CONTEXT=You are assisting US healthcare operations and medtech strategy teams...
# Or point at a markdown/text file (UTF-8). When both are set, the file is used if it can be read.
# AGENTIC_ORCHESTRATOR_CONTEXT_FILE=/absolute/path/to/orchestrator-context.md
#
# Merge extra agent-provider YAML directories into the dynamic planner catalog (same layout as
# config/agent_providers/). Use distinct provider ids in overlays. Path list uses os.pathsep.
# AGENTIC_EXTRA_AGENT_PROVIDERS_CATALOG_DIRS=/abs/path/to/repo/examples/verticals/healthcare/agent_providers
#
# MCP catalog already supports AGENTIC_EXTRA_MCP_PROVIDERS_PATH (see below); add a healthcare MCP dir the same way.
# AGENTIC_EXTRA_MCP_PROVIDERS_PATH=/abs/path/to/repo/examples/verticals/healthcare/mcp_providers

# Ollama URL (used by workflow router and Ollama providers)
OLLAMA_HOST=http://127.0.0.1:11434
# Auto-install runtimes for selected agents (default on):
# - Python .venv + requirements.txt when missing
# - Ollama binary (winget/brew/Linux install.sh) + serve + model pull when an Ollama agent is used
# Set to 0 to keep legacy behaviour (only selfcontained: true Ollama agents install/pull).
# AGENTIC_AUTO_ENSURE_RUNTIME=1
# On kubernetes, Ollama auto-ensure stays gated by selfcontained unless:
# AGENTIC_AUTO_ENSURE_OLLAMA_IN_K8S=1
# Non-quiet runs set AGENTIC_OLLAMA_VERBOSE so `ollama pull` streams progress (TTY: in-place \r per
# layer; piped: one final line per `pulling <digest>:` key). Embedded `ollama serve`
# stays silent; set AGENTIC_OLLAMA_SERVE_DEBUG=INFO only if you need serve logs.
# When verbose is off, `ollama pull` still streams normalized `(progress) ollama pull: ...` lines on
# stderr for the web UI pinned bar. Set AGENTIC_OLLAMA_PULL_PROGRESS_STDERR=0 to suppress them.
#
# CrewAI native MCP: mask MCPToolResolver tools_list UnboundLocalError (empty discovery) instead of crashing.
# AGENTIC_CREWAI_MCP_TOOLS_LIST_HOTFIX=0
#
# Dynamic planner hardware filtering:
# - Optional per-provider `hardware.architecture` in catalog YAML (cpu/gpu/tpu).
# - Optional per-provider min_vram_gb, plus Ollama model heuristics when unset.
# nvidia-smi picks largest GPU; set AGENTIC_ASSUME_VRAM_GB=8 to override detection.
# AGENTIC_AVAILABLE_ARCHITECTURES=cpu,gpu  # manual override (comma-separated)
# AGENTIC_ASSUME_GPU=1                      # force GPU as available
# AGENTIC_ASSUME_TPU=1                      # force TPU as available
# If borderline models are too slow, cap the effective VRAM used by the filter:
# - Treat your GPU as only 70% of its VRAM:
#   AGENTIC_MAX_VRAM_FRACTION=0.7
# - Or cap to an absolute value in GiB:
#   AGENTIC_MAX_VRAM_GB=5.6
# AGENTIC_DISABLE_HARDWARE_FILTER=1  # never drop catalog entries by VRAM
# AGENTIC_VRAM_HEURISTICS=0         # only use explicit min_vram_gb from YAML
# AGENTIC_HARDWARE_FILTER_QUIET=1    # no stderr line about excluded agent providers
# Credential filter (dynamic/static catalog): summarize skips into one stderr line when many (default >= 8).
# AGENTIC_CREDENTIAL_SKIP_SUMMARY_AT=8
# AGENTIC_CREDENTIAL_SKIP_VERBOSE=1  # always print one line per skipped provider
# Dynamic: disable heuristic MCP selection from user goal text (default on when catalog is non-empty).
# AGENTIC_DISABLE_MCP_GOAL_MATCH=1
# Agents with MCP tools: skip appended backstory hint about flat tool arguments (not recommended).
# AGENTIC_DISABLE_MCP_TOOL_HINT=1
# Step-to-step continuity: inject previous step output into the next task description.
# Disable if you prefer strict separation or you hit context-length issues.
# AGENTIC_STEP_CONTEXT_INJECT=1
# AGENTIC_STEP_CONTEXT_CHARS=4000
# Non-verbose run progress lines (Web UI can surface these in the activity bar)
# Set to 0/false to disable.
# AGENTIC_PROGRESS=1
# Dynamic-iterative: stream each intermediate crew answer to stdout (default off). When off,
# only the final synthesis is printed to stdout (or the last round if --dynamic-iterative-no-synthesize).
# AGENTIC_DYNAMIC_ITER_STREAM_STEPS=1

# Local learning loop (no model training; uses evaluation + user votes + stored stats)
# Writes under __orchestrator_learning__/ (gitignored):
# - stats.json (aggregates)
# - traces.jsonl (decision traces)
# - pending_ratings.jsonl (web UI votes, consumed on next planner run)
# AGENTIC_LEARNING=1
# AGENTIC_LEARNING_EVAL=1
# AGENTIC_EVAL_MODEL=  # defaults to controller/planner model
# AGENTIC_EVAL_GOAL_CHARS=2000
# AGENTIC_EVAL_OUTPUT_CHARS=12000

# Platform agent harness (per-catalog verification — see wiki Agent-harness-roadmap)
# AGENTIC_HARNESS_TIER=static
# AGENTIC_HARNESS_EVAL=1
# AGENTIC_HARNESS_EVAL_MODEL=
# AGENTIC_HARNESS_SKIP_SELFCONTAINED_INIT=1
# AGENTIC_HARNESS_FEED_PLANNER=1
# AGENTIC_HARNESS_RECORD_STATS=1

# User agent harness (domain scenario packs — see wiki User-agent-harnesses)
# os.pathsep-separated roots; each subdir with harness.yaml is one pack (basename = pack folder name).
# AGENTIC_EXTRA_AGENT_HARNESS_DIRS=/abs/path/to/my-deployment/harnesses
# AGENTIC_USER_HARNESS_RECORD_STATS=1
# AGENTIC_USER_HARNESS_FEED_PLANNER=1

# Final answer QA (hallucinations / unverified claims): extra LLM pass after --dynamic or after
# --dynamic-iterative synthesis; report is printed to stderr (visible in the web UI activity log).
# AGENTIC_FINAL_QA=1
# AGENTIC_QA_MODEL=  # defaults: AGENTIC_EVAL_MODEL -> AGENTIC_ITERATIVE_CONTROLLER_MODEL -> AGENTIC_PLANNER_MODEL
# AGENTIC_QA_GOAL_CHARS=2000
# AGENTIC_QA_OUTPUT_CHARS=16000

# Answer cache (dynamic / dynamic-iterative)
# If the same goal is asked again within the same orchestrator session, return the last finalized
# answer immediately and ask for confirmation ("Reply `no` to re-run.").
# AGENTIC_ANSWER_CACHE=1

# Cloud anonymization (Tier 1+2)
# When on (default), scrub emails/phones/SSNs/API keys/card-like digit runs before sending
# text to cloud planner/agent models (openai/anthropic/huggingface). Local Ollama skips scrub.
# Privacy/offline/"use ollama" wording also drops cloud providers from the planner catalog and
# refuses a cloud AGENTIC_PLANNER_MODEL. Session/KB persistence is scrubbed when enabled.
# AGENTIC_ANONYMIZE_CLOUD=1
# AGENTIC_CLOUD_PROVIDER_TYPES=openai,anthropic,huggingface
# Custom regex scrubbers (YAML). Default file: config/anonymize_patterns.yaml
# See config/anonymize_patterns_examples.yaml for sample EMP-/TKT- rules.
# AGENTIC_ANONYMIZE_PATTERNS_PATH=config/anonymize_patterns.yaml
# AGENTIC_EXTRA_ANONYMIZE_PATTERNS_PATH=  # extra file(s) or dir(s); os.pathsep / commas

# Cloud anonymization Tier 3 (reversible tokens, optional NER, tool-result scrub, vision)
# Reversible token maps: placeholders become unique per value, e.g. [EMAIL:1], [PERSON:2],
# recoverable via restore_tokens() from a session TokenMap (ContextVar + optional JSON under
# __orchestrator_sessions__/anon_maps/<slug>.json). Set 0 for static [EMAIL]-style placeholders.
# AGENTIC_ANONYMIZE_REVERSIBLE=1
# Optional Presidio NER pass (PERSON/LOCATION/NRP/...) after the regex scrub. Soft dependency —
# install `pip install -r requirements-anonymize.txt` (+ `python -m spacy download en_core_web_lg`)
# and enable, or a stderr warning is printed once and the pass is skipped.
# AGENTIC_ANONYMIZE_NER=0
# AGENTIC_ANONYMIZE_NER_ENTITIES=PERSON,LOCATION,NRP
# Scrub tool-call output (fetched pages, prior step handoff) before it flows into later steps.
# AGENTIC_ANONYMIZE_TOOL_RESULTS=1
# Prefer a local Ollama vision model over a cloud one for video-frame synopsis when
# anonymization is on; if the local model fails, skip the synopsis rather than send frames
# to the cloud. Set 0 to allow cloud vision as before.
# AGENTIC_ANONYMIZE_VISION_LOCAL=1
# AGENTIC_ANONYMIZE_VISION_MODEL=ollama/llava

# Local knowledge base (aggregates outputs across runs)
# Stores finalized outputs into __orchestrator_kb__/kb.sqlite3 (gitignored) and retrieves relevant
# snippets to include in the planner prompt.
# AGENTIC_KB=1
# AGENTIC_KB_MAX_HITS=4
# AGENTIC_KB_SNIPPET_CHARS=600
# AGENTIC_KB_DOC_CHARS=20000
# Iterative dynamic controller (when you run --dynamic-iterative --dynamic-iterative-auto)
# AGENTIC_ITERATIVE_CONTROLLER_MODEL=gpt-4o-mini
# AGENTIC_ITERATIVE_CONTROLLER_EXCERPT_CHARS=12000
# CLI defaults (also caps web UI when set): AGENTIC_DYNAMIC_ITERATIVE_ROUNDS=4
# AGENTIC_DYNAMIC_ITERATIVE_MAX_ROUNDS=8
# AGENTIC_DYNAMIC_ITERATIVE_MIN_ROUNDS=1
# Jetson / edge tracked overrides: config/env.jetson (apply via scripts/jetson-apply-env.sh)
# The controller will also attempt to estimate remaining rounds; it improves as more rounds complete.
# Model id for routing when you pass a TASK on the CLI (must be pulled in Ollama)
ROUTER_OLLAMA_MODEL=llama3.2

# TPU-serving OpenAI-compatible endpoints for provider types:
# - type: vllm      -> VLLM_BASE_URL (or YAML vllm_base_url/base_url)
# - type: jetstream -> JETSTREAM_BASE_URL (or YAML jetstream_base_url/base_url)
# VLLM_BASE_URL=http://127.0.0.1:8000
# VLLM_API_KEY=
# JETSTREAM_BASE_URL=http://127.0.0.1:8001
# JETSTREAM_API_KEY=

# Optional: directories (os.pathsep-separated) scanned for extra AgentProvider classes.
# Prefer AGENTIC_EXTRA_AGENT_PROVIDERS_PATH; AGENTIC_EXTRA_PROVIDERS_PATH is still read if unset.
# Windows example: AGENTIC_EXTRA_AGENT_PROVIDERS_PATH=D:\my-agent-providers
# Unix example:   AGENTIC_EXTRA_AGENT_PROVIDERS_PATH=/home/me/my-agent-providers
# AGENTIC_EXTRA_AGENT_PROVIDERS_PATH=

# Home Assistant MCP catalog entry: config/mcp_providers/home_assistant.yaml
# https://www.home-assistant.io/integrations/mcp_server/ — base URL without trailing slash;
# create a long-lived access token under Profile → Security.
# HOME_ASSISTANT_URL=https://your-instance.example.com
# HOME_ASSISTANT_TOKEN=

# Optional: web search MCP servers (entries are automatically hidden unless required env vars are set).
# These are templates: you must run/host an MCP server and point the *_MCP_URL at it.
# TAVILY_API_KEY=
# TAVILY_MCP_URL=https://your-tavily-mcp.example.com/mcp
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_MCP_URL=https://your-brave-search-mcp.example.com/mcp

# Exa search MCP (config/mcp_providers/search_exa.yaml) — https://dashboard.exa.ai/api-keys
# EXA_API_KEY=

# Xquik remote MCP (config/mcp_providers/xquik.yaml): https://docs.xquik.com/mcp/overview
# XQUIK_API_KEY=

# Bargo Congress Trades MCP (config/mcp_providers/bargo_congress.yaml): https://www.bargo.ai/free-apis/congress
# Get a free key at https://www.bargo.ai/free-apis/dash
# BARGO_API_KEY=

# Official URL fetch MCP (config/mcp_providers/fetch_url.yaml): pip install mcp-server-fetch into this venv, then:
# AGENTIC_MCP_FETCH_ENABLED=1

# Official MCP in-memory knowledge graph (config/mcp_providers/memory_knowledge_graph.yaml): requires Node/npx; opt-in:
# AGENTIC_MCP_MEMORY_MCP_ENABLED=1

# First-party media MCP (config/mcp_providers/media_understand.yaml + audio/video aliases):
# image describe, audio transcribe (faster-whisper recommended), video frame analysis.
# AGENTIC_MCP_MEDIA_ENABLED=1
# Optional: pip install faster-whisper  (and ffmpeg on PATH for video)
# AGENTIC_MEDIA_WHISPER_MODEL=base
# AGENTIC_MEDIA_VISION_MODEL=  # defaults to AGENTIC_VIDEO_VISION_MODEL / AGENTIC_PLANNER_MODEL

# Official MCP filesystem server (config/mcp_providers/filesystem_local.yaml): absolute directory the model may access:
# FILESYSTEM_MCP_ALLOWED_DIRECTORY=D:\Projects\my-safe-root

# Optional: extra MCP provider YAML directories (os.pathsep-separated), merged with --mcp-providers-catalog.
# Windows example: AGENTIC_EXTRA_MCP_PROVIDERS_PATH=D:\my-mcp-providers
# AGENTIC_EXTRA_MCP_PROVIDERS_PATH=

# Agent skills catalog (procedural instructions injected into task descriptions):
# --agent-skills-catalog default: config/agent_skills
# AGENTIC_AGENT_SKILLS_CATALOG=
# Optional extra skill YAML directories (os.pathsep-separated), merged with --agent-skills-catalog.
# AGENTIC_EXTRA_AGENT_SKILLS_PATH=
# Max injected skill markdown chars per task (default 24000).
# AGENTIC_SKILLS_MAX_CHARS_PER_TASK=24000
# Disable keyword auto-attach of skills when the planner omits skill_ids (default off).
# AGENTIC_DISABLE_SKILL_GOAL_MATCH=0
# Fail dynamic runs when the planner references unknown skill ids (default: warn and drop).
# AGENTIC_STRICT_SKILL_IDS=0

# RAG sources catalog (retrieval corpora; sqlite-fts shipped, embedding/hybrid planned):
# --rag-sources-catalog default: config/rag_sources
# AGENTIC_EXTRA_RAG_SOURCES_PATH=
# Global inject-mode token budget across all granted RAG sources (default 6000; ~chars/4).
# AGENTIC_RAG_INJECT_MAX_TOKENS=6000

# After saving extracted files, run npm install/test/build under the output tree (default on).
# Set to 0, false, no, or off to skip (same effect as CLI --no-verify).
# AGENTIC_VERIFY=1
