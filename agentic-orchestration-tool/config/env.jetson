# Jetson / edge orchestrator overrides (tracked in git).
# Applied to agentic-orchestration-tool/.env by scripts/jetson-apply-env.sh on deploy.
#
# Do not put secrets here. Operator-specific keys stay in .env (gitignored).

# --- Edge platform + Ollama runtime detection ---
AGENTIC_EDGE_PLATFORM=jetson
AGENTIC_OLLAMA_RUNTIME=auto

# --- Local LLM catalog (host Ollama, not self-contained workflow) ---
AGENTIC_AGENT_PROVIDERS_CATALOG=config/agent_providers_jetson
AGENTIC_PLANNER_MODEL=ollama/llama3.2:3b
AGENTIC_OPENAI_PROXY_DYNAMIC_AGENT_PROVIDER_IDS=ollama_llama3_2_3b
AGENTIC_ASSUME_VRAM_GB=48
AGENTIC_ASSUME_GPU=1

# --- Iterative mode: keep rounds low on a 3B edge model ---
AGENTIC_DYNAMIC_ITERATIVE_ROUNDS=2
AGENTIC_DYNAMIC_ITERATIVE_MAX_ROUNDS=3
AGENTIC_DYNAMIC_ITERATIVE_MIN_ROUNDS=1

# --- Web UI defaults (simple chat → Dynamic, not 8-round iterative) ---
AGENTIC_WEB_DEFAULT_RUN_MODE=dynamic
AGENTIC_WEB_DEFAULT_AUTO_ITER=0
AGENTIC_WEB_DEFAULT_ITERATIVE_ROUNDS=2
AGENTIC_WEB_DEFAULT_ITERATIVE_MAX_ROUNDS=3

# --- Performance (planner trim + skip post-run LLM on edge) ---
AGENTIC_ORCHESTRATOR_MAX_PLANNER_TURNS=2
AGENTIC_ORCHESTRATOR_EXCERPT_CHARS=4000
AGENTIC_FINAL_QA=0
AGENTIC_LEARNING_EVAL=0
AGENTIC_WEB_DEFAULT_RESET_SESSION_SIMPLE=1
AGENTIC_WEB_DEFAULT_LIMIT_PLANNER_HISTORY=1
AGENTIC_WEB_DEFAULT_SKIP_FINAL_QA=1
AGENTIC_WEB_DEFAULT_SKIP_LEARNING_EVAL=1

# --- Ollama from k8s pods via host gateway (API base only; avoid duplicate OLLAMA_HOST in secrets) ---
OLLAMA_API_BASE=http://host.k3s.internal:11434

# --- Coordinator listens on all interfaces inside the pod ---
AGENTIC_WEB_HOST=0.0.0.0
