# Jetson / edge orchestrator overrides (tracked in git).
# Applied to agentic-orchestration-tool/.env by scripts/jetson-apply-env.sh on deploy.
#
# Do not put secrets here. Operator-specific keys stay in .env (gitignored).

# --- Edge platform + Ollama runtime detection ---
AGENTIC_EDGE_PLATFORM=jetson
AGENTIC_OLLAMA_RUNTIME=auto

# --- Local LLM catalog (host Ollama, not self-contained workflow) ---
AGENTIC_AGENT_PROVIDERS_CATALOG=config/agent_providers_jetson
AGENTIC_EXTRA_AGENT_SKILLS_PATH=config/agent_skills_jetson
AGENTIC_PLANNER_MODEL=ollama/llama3.2:3b
# Fallback when Chat sends no agent chips. Non-empty selectedAgentProviderIds override this.
# Planner also skips Ollama agents whose models are missing from OLLAMA_API_BASE /api/tags.
AGENTIC_OPENAI_PROXY_DYNAMIC_AGENT_PROVIDER_IDS=ollama_llama3_2_3b
# HA watering / OpenAI SDK: name:tag models proxy straight to Ollama (not main.py).
AGENTIC_CHAT_COMPLETIONS_BACKEND=auto
AGENTIC_CHAT_COMPLETIONS_OLLAMA_MAX_CONCURRENT=2
# HA may request qwen2.5:14b-instruct; prefer pulled CORE models (see jetson-pull-ollama-models.sh).
AGENTIC_CHAT_COMPLETIONS_OLLAMA_FALLBACK_MODEL=llama3.2:3b
AGENTIC_ASSUME_VRAM_GB=48
AGENTIC_ASSUME_GPU=1

# --- Iterative mode: keep rounds low on a 3B edge model ---
AGENTIC_DYNAMIC_ITERATIVE_ROUNDS=2
AGENTIC_DYNAMIC_ITERATIVE_MAX_ROUNDS=3
AGENTIC_DYNAMIC_ITERATIVE_MIN_ROUNDS=1

# --- Web UI defaults (simple chat → Dynamic, not 8-round iterative) ---
AGENTIC_WEB_DEFAULT_RUN_MODE=dynamic
AGENTIC_WEB_DEFAULT_AUTO_ITER=0
AGENTIC_WEB_DEFAULT_ITERATIVE_ROUNDS=2
AGENTIC_WEB_DEFAULT_ITERATIVE_MAX_ROUNDS=3

# --- Performance (planner trim + skip post-run LLM on edge) ---
AGENTIC_ORCHESTRATOR_MAX_PLANNER_TURNS=2
AGENTIC_ORCHESTRATOR_EXCERPT_CHARS=4000
AGENTIC_FINAL_QA=0
AGENTIC_LEARNING_EVAL=0
# The impartial QA gate stays on but explicitly advisory here: with both reviewers above disabled
# it soft-skips unless assertions are configured; this pin guarantees it can never change an
# exit code on the edge device.
AGENTIC_IMPARTIAL_QA_FAIL=0
# English-default reply locale: sanitize strips unexpected CJK; impartial QA asserts against it.
AGENTIC_REPLY_LOCALE=en
AGENTIC_IMPARTIAL_QA_ASSERTIONS_FILE=config/impartial_qa_assertions.json
AGENTIC_WEB_DEFAULT_RESET_SESSION_SIMPLE=1
AGENTIC_WEB_DEFAULT_LIMIT_PLANNER_HISTORY=1
AGENTIC_WEB_DEFAULT_SKIP_FINAL_QA=1
AGENTIC_WEB_DEFAULT_SKIP_LEARNING_EVAL=1

# --- Planner model warm (Ollama keep-alive) + planner LLM chat greeting ---
# Keeps llama3.2:3b loaded on the host Ollama server (planner + crew share this model on edge).
# Warm pool workers also ping on startup (AGENTIC_WARM_POOL_OLLAMA_PREWARM=1).
AGENTIC_OLLAMA_KEEPALIVE=1
AGENTIC_OLLAMA_KEEP_ALIVE=-1
# Cap Ollama's default context (daemon env OLLAMA_CONTEXT_LENGTH). Prevents
# 128k models like granite-code from allocating a ~40 GiB KV cache on Jetson.
AGENTIC_OLLAMA_CONTEXT_LENGTH=16384
AGENTIC_OLLAMA_KEEPALIVE_INTERVAL_MS=300000
AGENTIC_WEB_PLANNER_GREET=1
# Static fallback only when planner greet fails (set 0 to disable):
# AGENTIC_WEB_WELCOME_MESSAGE=Hello! How can I help you today?

# --- Edge: single-agent Jetson — no delegation tool (3B models hallucinate tool calls) ---
AGENTIC_K8S_DELEGATION_ENABLED=0

# --- In-cluster Ollama (managed_k8s). Host systemd Ollama is not used. ---
AGENTIC_OLLAMA_MODE=managed_k8s
AGENTIC_JETSON_ENABLE_OLLAMA=1
OLLAMA_API_BASE=http://agentic-ollama:11434
# Ada GPU: privileged hostPath /dev/nvidia* + driver libs (see ollama/deployment.yaml).
# Needs NVIDIA driver 550+ (Ada is on 595.x). Jetson uses host-binary mode (ignores this).
AGENTIC_OLLAMA_IMAGE=ollama/ollama:latest
# Jetson Ollama models: set on-device (migrate script / env.host), default
# /mnt/nvme/ollama/models in jetson-enable-ollama.sh — do not pin here (Ada shares env.jetson).

# --- Host metrics: jtop GPU/CPU on Jetson (agentic-jtop-metrics.service writes JSON on host) ---
AGENTIC_JETSON_JTOP_METRICS_PATH=/host/agentic-metrics/jtop-metrics.json

# --- Optional extras: plant-knowledge MCP + OpenClaw-synced MCP catalog ---
# OpenClaw plugin writes YAML under ~/.openclaw/agentic-orchestration/openclaw-mcp-providers
# (hostPath → /openclaw/mcp-providers via jetson-openclaw-mcp-hostpath-patch.yaml).
# Prepend OpenClaw catalog so planner can select openclaw_filesystem / openclaw_bridge.
AGENTIC_EXTRA_MCP_PROVIDERS_PATH=/openclaw/mcp-providers:/app/tool/extras/plant-knowledge-mcp/config
PLANT_KNOWLEDGE_MCP_URL=http://plant-knowledge-mcp.plant-knowledge.svc.cluster.local:8080/mcp
AGENTIC_K8S_EXTRA_HTTP_MCPS=plant_knowledge

# Media understanding MCP (image describe / audio transcribe / video frames) — stdio in worker/coord.
AGENTIC_MCP_MEDIA_ENABLED=1
# Weather MCP (npx @dangahagan/weather-mcp) — stdio in worker; no API keys.
AGENTIC_MCP_WEATHER_ENABLED=1
# Include media_understand / weather_mcp when worker stdio MCPs are enabled (comma-separated).
# openclaw_filesystem: OpenClaw mcp.servers.filesystem synced by the AO plugin.
AGENTIC_K8S_WORKER_STDIO_MCPS=fetch_url,filesystem_local,openclaw_filesystem,media_understand,media_audio_transcribe,media_video_analyze,weather_mcp

# OpenClaw Control UI workspace (also mounted at this path for openclaw_filesystem stdio args).
FILESYSTEM_MCP_ALLOWED_DIRECTORY=/home/zlatko.lakisic/.openclaw/workspace

# --- Coordinator listens on all interfaces inside the pod ---
AGENTIC_WEB_HOST=0.0.0.0

# --- Engine API daemon (KnowBuddy): published on host :8765 + NodePort 30765 ---
# Additive — Node web UI stays on NodePort 30487. Set AGENTIC_JETSON_ENABLE_ENGINE=0 to skip.
# KnowBuddy Settings → Remote URL = http://<jetson-ip>:8765  (NOT :30487)
AGENTIC_SERVE_HOST=0.0.0.0
AGENTIC_SERVE_PORT=8765
# KnowBuddy remote session bridge (AO v1.27+) — ephemeral client.* overlays + MCP tunnel.
AGENTIC_SERVE_SESSION_OVERLAY=1
AGENTIC_SERVE_MCP_TUNNEL=1
# Stream planner/agent progress separately from incremental final-answer output.
AGENTIC_SERVE_STREAM_STDOUT=1
AGENTIC_SERVE_STREAM_THOUGHTS=1
# CrewAI: never block headless pods on "view execution traces?" stdin (20s).
# Also set on agentic-engine Deployment; secret sync covers workers/coordinator.
CREWAI_TESTING=true
CREWAI_TRACING_ENABLED=false
# Pull missing ollama models for overlay agents via OLLAMA_API_BASE (HTTP only; no pod spawn).
# AGENTIC_SERVE_SESSION_OVERLAY_ENSURE_OLLAMA=1
# Optional tuning (defaults are fine):
# AGENTIC_SERVE_SESSION_OVERLAY_TTL_S=3600
# AGENTIC_SERVE_SESSION_OVERLAY_MAX_BYTES=524288
# AGENTIC_SERVE_SESSION_OVERLAY_MAX_ENTRIES=64
# Keep identity optional on edge (Warpgate fronts the web UI; desktop KnowBuddy may omit headers).
# AGENTIC_REQUIRE_IDENTITY=0
