[Unit]
Description=Agentic orchestration — Jetson GPU metrics for web UI (user)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/projects/agentic-orchestration/agentic-orchestration-tool/scripts/jetson-jtop-metrics-writer.py --output /var/projects/agentic-orchestration/var/agentic-metrics/jtop-metrics.json --interval 1 --source auto
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
