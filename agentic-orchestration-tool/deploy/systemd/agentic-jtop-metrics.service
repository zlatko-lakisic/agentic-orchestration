[Unit]
Description=Agentic orchestration — Jetson GPU metrics for web UI
After=network-online.target
Wants=network-online.target
# jtop.service is optional; writer falls back to tegrastats when jtop is unavailable.

[Service]
Type=simple
User=root
# Reap tegrastats children on stop/restart (avoids hung sampler stacks — #95).
KillMode=control-group
TimeoutStopSec=10
ExecStart=/usr/bin/python3 /var/projects/agentic-orchestration/agentic-orchestration-tool/scripts/jetson-jtop-metrics-writer.py --output /var/projects/agentic-orchestration/var/agentic-metrics/jtop-metrics.json --interval 1 --source auto
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
