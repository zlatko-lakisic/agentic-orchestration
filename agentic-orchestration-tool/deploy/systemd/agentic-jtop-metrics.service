[Unit]
Description=Agentic orchestration — jtop metrics for web UI
After=jtop.service
Requires=jtop.service

[Service]
Type=simple
User=root
Group=jtop
ExecStart=/usr/bin/python3 /var/projects/agentic-orchestration/agentic-orchestration-tool/scripts/jetson-jtop-metrics-writer.py --output /var/run/agentic/jtop-metrics.json --interval 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
