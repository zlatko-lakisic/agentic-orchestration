[Unit]
Description=Watch AO host control request files

[Path]
PathExists=/var/projects/agentic-orchestration/var/agentic-control/reboot.request
PathExists=/var/projects/agentic-orchestration/var/agentic-control/ollama.restart.request
Unit=agentic-host-control.service

[Install]
WantedBy=multi-user.target
