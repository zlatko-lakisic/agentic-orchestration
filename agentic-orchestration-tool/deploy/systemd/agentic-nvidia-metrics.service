[Unit]
Description=Agentic orchestration — NVIDIA host metrics for engine / KnowBuddy
After=network.target
# Optional: wait for NVIDIA driver nodes if present
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=simple
User=root
# Root-owned copy installed by scripts/install-nvidia-host-metrics.sh (never run
# files from the deploy user's git checkout as root; see scripts/lib-root-install.sh).
ExecStart=/usr/bin/python3 /usr/local/libexec/agentic-orchestration/nvidia-host-metrics-writer.py --output /var/projects/agentic-orchestration/var/agentic-metrics/nvidia-metrics.json --interval 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
