[Unit]
Description=Agentic orchestration — NVIDIA host metrics for engine / KnowBuddy
After=network.target
# Optional: wait for NVIDIA driver nodes if present
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /var/projects/agentic-orchestration/agentic-orchestration-tool/scripts/nvidia-host-metrics-writer.py --output /var/projects/agentic-orchestration/var/agentic-metrics/nvidia-metrics.json --interval 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
