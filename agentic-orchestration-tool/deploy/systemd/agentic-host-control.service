[Unit]
Description=Agentic orchestration — host control (reboot / Ollama restart)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/var/projects/agentic-orchestration/agentic-orchestration-tool/scripts/agentic-host-control-run.sh /var/projects/agentic-orchestration

[Install]
WantedBy=multi-user.target
