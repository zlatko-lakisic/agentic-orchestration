[Unit]
Description=Agentic orchestration — AMD host metrics for engine / web UI
After=network.target

[Service]
Type=simple
User=root
# Root-owned copy installed by scripts/install-amd-host-metrics.sh (never run
# files from the deploy user's git checkout as root; see scripts/lib-root-install.sh).
ExecStart=/usr/bin/python3 /usr/local/libexec/agentic-orchestration/amd-host-metrics-writer.py --output /var/projects/agentic-orchestration/var/agentic-metrics/amd-metrics.json --interval 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
