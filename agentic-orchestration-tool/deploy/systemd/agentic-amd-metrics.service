[Unit]
Description=Agentic orchestration — AMD host metrics for engine / web UI
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /var/projects/agentic-orchestration/agentic-orchestration-tool/scripts/amd-host-metrics-writer.py --output /var/projects/agentic-orchestration/var/agentic-metrics/amd-metrics.json --interval 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
