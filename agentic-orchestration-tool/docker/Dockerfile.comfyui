# AO-owned ComfyUI image (Ada / amd64). Not a community image.
# Build (from monorepo root or tool dir — context is this file's directory parent):
#   docker build -f agentic-orchestration-tool/docker/Dockerfile.comfyui \
#     -t ghcr.io/zlatko-lakisic/agentic-comfyui:local \
#     agentic-orchestration-tool
#
# Pins: bump COMFYUI_GIT_REF / LTXVIDEO_GIT_REF together and re-smoke Wan + LTX.
# Wan 2.2 uses ComfyUI native nodes (no WanVideoWrapper). LTX needs ComfyUI-LTXVideo.

ARG CUDA_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
FROM ${CUDA_IMAGE}

# Pin by commit (plan: pin ComfyUI + LTX node). Tags noted for humans.
# ComfyUI v0.46.2 — native Wan 2.2 nodes (Wan22ImageToVideoLatent, WanImageToVideo, …)
ARG COMFYUI_GIT_COMMIT=10cdd12609eb17e8a90f2a2dd811b1c82f6107e7
# ComfyUI-LTXVideo v1.1.1
ARG LTXVIDEO_GIT_COMMIT=ced6bad92b82f90028e1e1fd5a37527302550fc5
ARG DEBIAN_FRONTEND=noninteractive

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    COMFYUI_DIR=/opt/ComfyUI \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone https://github.com/comfyanonymous/ComfyUI.git "${COMFYUI_DIR}" \
    && cd "${COMFYUI_DIR}" \
    && git checkout "${COMFYUI_GIT_COMMIT}" \
    && pip install --upgrade pip \
    && pip install -r requirements.txt \
    && mkdir -p custom_nodes \
    && git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git \
         custom_nodes/ComfyUI-LTXVideo \
    && cd custom_nodes/ComfyUI-LTXVideo \
    && git checkout "${LTXVIDEO_GIT_COMMIT}" \
    && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi \
    && cd "${COMFYUI_DIR}" \
    && python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"

# Models + output live on hostPath (never baked into the image).
VOLUME ["/opt/ComfyUI/models", "/opt/ComfyUI/output", "/opt/ComfyUI/input"]

WORKDIR /opt/ComfyUI
EXPOSE 8188

# --disable-smart-memory: unload promptly so /free + residency see free VRAM.
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188", "--disable-smart-memory"]
